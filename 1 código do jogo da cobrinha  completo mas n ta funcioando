# Código corrigido (versão mínima com os bugs principais ajustados)
import turtle
import time
import random
import os

# Tentar importar winsound para som (windows)
try:
    import winsound
    SOM_DISPONIVEl = True
except ImportError:
    SOM_DISPONIVEl = False

ARQUIVO_RECORDE = "recorde.txt"

DIFICULDADES = {
    "1": {"nome": "Fácil", "velocidade": 0.15, "cor_fundo": "dark green"},
    "2": {"nome": "Médio", "velocidade": 0.1, "cor_fundo": "dark blue"},
    "3": {"nome": "Difícil", "velocidade": 0.06, "cor_fundo": "dark red"},
    "4": {"nome": "Impossível", "velocidade": 0.03, "cor_fundo": "black"}
}

pontos = 0
recorde = 0
velocidade_jogo = 0.1
jogo_pausado = False
jogo_ativo = False
dificuldade_atual = "2"

def carregar_recorde():
    global recorde
    try:
        if os.path.exists(ARQUIVO_RECORDE):
            with open(ARQUIVO_RECORDE, "r") as arquivo:
                recorde = int(arquivo.read().strip())
    except:
        recorde = 0

def salvar_recorde():
    global recorde
    try:
        with open(ARQUIVO_RECORDE, "w") as arquivo:
            arquivo.write(str(recorde))
    except:
        pass

def tocar_som(tipo):
    if not SOM_DISPONIVEl:
        return
    try:
        if tipo == "comer":
            winsound.Beep(800, 100)
        elif tipo == "colisao":
            winsound.Beep(200, 300)
        elif tipo == "recorde":
            winsound.Beep(523, 100)
            winsound.Beep(659, 100)
            winsound.Beep(784, 100)
            winsound.Beep(1047, 100)
        elif tipo == "inicio":
            winsound.Beep(440, 150)
            winsound.Beep(550, 150)
            winsound.Beep(660, 200)
    except:
        pass

carregar_recorde()

tela = turtle.Screen()
tela.title("Jogo da Cobrinha - Super Edition")
tela.bgcolor("black")
tela.setup(width=600, height=650)
tela.tracer(0)

tela_mensagem = turtle.Turtle()
tela_mensagem.speed(0)
tela_mensagem.color("white")
tela_mensagem.penup()
tela_mensagem.hideturtle()

cabeca = turtle.Turtle()
cabeca.speed(0)
cabeca.shape("square")
cabeca.color("lime")
cabeca.penup()
cabeca.goto(0, 0)
cabeca.direction = "stop"

comida = turtle.Turtle()
comida.speed(0)
comida.shape("circle")
comida.color("red")
comida.penup()
comida.goto(0, 100)

comida_bonus = turtle.Turtle()
comida_bonus.speed(0)
comida_bonus.shape("triangle")
comida_bonus.color("gold")
comida_bonus.penup()
comida_bonus.goto(1000, 1000)
comida_bonus.hideturtle()
comida_bonus_ativa = False
comida_bonus_tempo = 0

segmentos = []

placar = turtle.Turtle()
placar.speed(0)
placar.color("yellow")
placar.penup()
placar.hideturtle()
placar.goto(0, 200)

info_extra = turtle.Turtle()
info_extra.speed(0)
info_extra.color("yellow")
info_extra.penup()
info_extra.hideturtle()
info_extra.goto(0, -310)

def atualizar_placar():
    placar.clear()
    placar.write(f"Pontos: {pontos}  |  Recorde: {recorde}  |  {DIFICULDADES[dificuldade_atual]['nome']}",
                 align="center", font=("Courier", 18, "bold"))

def atualizar_info():
    info_extra.clear()
    info_extra.write("P = Pausar  |  R = Reiniciar | Q = Sair",
                     align="center", font=("Courier", 12, "normal"))

def mostrar_tela_inicio():
    global jogo_ativo
    jogo_ativo = False

    cabeca.hideturtle()
    comida.hideturtle()
    comida_bonus.hideturtle()
    for seg in segmentos:
        seg.hideturtle()
    placar.clear()
    info_extra.clear()

    tela.bgcolor("black")
    tela_mensagem.clear()
    tela_mensagem.goto(0, 150)
    tela_mensagem.color("lime")
    tela_mensagem.write("Jogo da cobrinha", align="center", font=("Courier", 28, "bold"))

    tela_mensagem.goto(0, 80)
    tela_mensagem.color("white")
    tela_mensagem.write("Super Edition", align="center", font=("Courier", 18, "italic"))

    tela_mensagem.goto(0, 20)
    tela_mensagem.color("yellow")
    tela_mensagem.write(f"record Atual: {recorde} pontos", align="center", font=("Courier", 16,"bold"))

    tela_mensagem.goto(0, -40)
    tela_mensagem.color("cyan")
    tela_mensagem.write("Escolha a Dificuldade", align="center", font=("Courier", 16, "italic"))

    tela_mensagem.goto(0, -80)
    tela_mensagem.color("green")
    tela_mensagem.write("1 - Fácil", align="center", font=("Courier", 14, "normal"))

    tela_mensagem.goto(0, -110)
    tela_mensagem.color("blue")
    tela_mensagem.write("2 - Médio", align="center", font=("Courier", 14, "normal"))

    tela_mensagem.goto(0, -140)
    tela_mensagem.color("red")
    tela_mensagem.write("3 - Difícil", align="center", font=("Courier", 14, "normal"))

    tela_mensagem.goto(0, -170)
    tela_mensagem.color("purple")
    tela_mensagem.write("4 - impossível", align="center", font=("Courier", 14, "normal"))

    tela_mensagem.goto(0, -220)
    tela_mensagem.color("white")
    tela_mensagem.write("Pressione o número para começar!", align="center", font=("Courier", 12, "normal"))

    tela.update()

def mostrar_game_over():
    global jogo_ativo
    jogo_ativo = False

    tela_mensagem.clear()
    tela.bgcolor("dark red")
    tela.update()
    time.sleep(0.1)
    tela.bgcolor("black")
    tela.update()
    time.sleep(0.1)
    tela.bgcolor("dark red")
    tela.update()
    time.sleep(0.1)
    tela.bgcolor("black")

    tela_mensagem.goto(0, 100)
    tela_mensagem.color("red")
    tela_mensagem.write(" GAME OVER", align="center", font=("Courier", 32, "bold"))

    tela_mensagem.goto(0, 40)
    tela_mensagem.color("white")
    tela_mensagem.write("Pontuação Final", align="center", font=("Courier", 20, "bold"))

    tela_mensagem.goto(0, 0)
    tela_mensagem.color("yellow")
    tela_mensagem.write(f"{pontos}", align="center", font=("Courier", 18, "bold"))

    if pontos >= recorde and pontos > 0:
        tela_mensagem.goto(0, -40)
        tela_mensagem.color("gold")
        tela_mensagem.write("Novo recorde!", align="center", font=("Courier", 20, "bold"))

    tela_mensagem.goto(0, -100)
    tela_mensagem.color("cyan")
    tela_mensagem.write("Pressione ESPAÇO para jogar novamente", align="center", font=("Courier", 14, "bold"))

    tela_mensagem.goto(0, -130)
    tela_mensagem.color("white")
    tela_mensagem.write("Pressione M para o Menu Principal", align="center", font=("Courier", 14, "bold"))
    tela.update()

def spawnar_comida_bonus():
    global comida_bonus_ativa, comida_bonus_tempo
    x = random.randint(-270, 270)
    y = random.randint(-270, 250)
    comida_bonus.goto(x, y)
    comida_bonus.showturtle()
    comida_bonus_ativa = True
    comida_bonus_tempo = time.time()

def esconder_comida_bonus():
    global comida_bonus_ativa
    comida_bonus.goto(1000, 1000)
    comida_bonus.hideturtle()
    comida_bonus_ativa = False

def resetar_apos_colisão():
    global pontos, recorde

    tocar_som("colisao")

    if pontos > recorde:
        recorde = pontos
        salvar_recorde()
        tocar_som("recorde")

    cabeca.hideturtle()
    for segmento in segmentos:
        segmento.hideturtle()

    esconder_comida_bonus()
    mostrar_game_over()

def mover():
    if cabeca.direction == "up":
        y = cabeca.ycor()
        cabeca.sety(y + 20)
    if cabeca.direction == "down":
        y = cabeca.ycor()
        cabeca.sety(y - 20)
    if cabeca.direction == "left":
        x = cabeca.xcor()
        cabeca.setx(x - 20)
    if cabeca.direction == "right":
        x = cabeca.xcor()
        cabeca.setx(x + 20)

def efeito_comer():
    cor_original = cabeca.color()[0]
    cabeca.color("white")
    tela.update()
    time.sleep(0.05)
    cabeca.color(cor_original)

# Funções de controle (em escopo global) --------------------
def selecionar_facil():
    if not jogo_ativo:
        iniciar_jogo("1")

def selecionar_medio():
    if not jogo_ativo:
        iniciar_jogo("2")

def selecionar_dificil():
    if not jogo_ativo:
        iniciar_jogo("3")

def selecionar_impossivel():
    if not jogo_ativo:
        iniciar_jogo("4")

def jogar_novamente():
    if not jogo_ativo:
        iniciar_jogo(dificuldade_atual)

def voltar_menu():
    mostrar_tela_inicio()

def ir_cima():
    global jogo_pausado
    if jogo_ativo and not jogo_pausado and cabeca.direction != "down":
        cabeca.direction = "up"

def ir_baixo():
    global jogo_pausado
    if jogo_ativo and not jogo_pausado and cabeca.direction != "up":
        cabeca.direction = "down"

def ir_esquerda():
    global jogo_pausado
    if jogo_ativo and not jogo_pausado and cabeca.direction != "right":
        cabeca.direction = "left"

def ir_direita():
    global jogo_pausado
    if jogo_ativo and not jogo_pausado and cabeca.direction != "left":
        cabeca.direction = "right"

def pausar_jogo():
    global jogo_pausado
    if jogo_ativo:
        jogo_pausado = not jogo_pausado
        tela_mensagem.clear()
        if jogo_pausado:
            tela_mensagem.goto(0, 0)
            tela_mensagem.color("gold")
            tela_mensagem.write(" PAUSADO ", align="center", font=("Courier", 30, "bold"))

# Função para iniciar o jogo ---------------------------------
def iniciar_jogo(dificuldade):
    global pontos, velocidade_jogo, jogo_ativo, jogo_pausado, dificuldade_atual
    global comida_bonus_ativa, comida_bonus_tempo

    dificuldade_atual = dificuldade
    velocidade_jogo = DIFICULDADES[dificuldade]["velocidade"]

    tocar_som("inicio")
    tela_mensagem.clear()
    tela.bgcolor(DIFICULDADES[dificuldade]["cor_fundo"])

    pontos = 0   # CORREÇÃO: resetar pontos corretamente
    jogo_pausado = False
    jogo_ativo = True
    comida_bonus_ativa = False
    comida_bonus_tempo = 0

    cabeca.goto(0, 0)
    cabeca.direction = "stop"
    cabeca.showturtle()

    for segmento in segmentos:
        segmento.hideturtle()
    segmentos.clear()

    comida.goto(0, 100)
    comida.showturtle()
    esconder_comida_bonus()

    atualizar_placar()
    atualizar_info()
    tela.update()

def reiniciar_jogo():
    if jogo_ativo:
        iniciar_jogo(dificuldade_atual)

def sair_jogo():
    salvar_recorde()
    tela.bye()

# Bindings corretos: passar referência para as funções
tela.listen()
tela.onkeypress(ir_cima, "Up")
tela.onkeypress(ir_baixo, "Down")
tela.onkeypress(ir_esquerda, "Left")
tela.onkeypress(ir_direita, "Right")
tela.onkeypress(ir_cima, "w")
tela.onkeypress(ir_baixo, "s")
tela.onkeypress(ir_esquerda, "a")
tela.onkeypress(ir_direita, "d")
tela.onkeypress(pausar_jogo, "p")
tela.onkeypress(reiniciar_jogo, "r")
tela.onkeypress(sair_jogo, "q")
tela.onkeypress(selecionar_facil, "1")
tela.onkeypress(selecionar_medio, "2")
tela.onkeypress(selecionar_dificil, "3")
tela.onkeypress(selecionar_impossivel, "4")
tela.onkeypress(jogar_novamente, "space")
tela.onkeypress(voltar_menu, "m")

mostrar_tela_inicio()

# loop principal
while True:
    tela.update()

    if not jogo_ativo or jogo_pausado:
        time.sleep(0.1)
        continue

    if cabeca.xcor() > 290 or cabeca.xcor() < -290 or cabeca.ycor() > 270 or cabeca.ycor() < -290:
        resetar_apos_colisão()
        continue

    if cabeca.distance(comida) < 20:
        tocar_som("comer")
        efeito_comer()
        x = random.randint(-270, 270)
        y = random.randint(-270, 250)
        comida.goto(x, y)

        novo_segmento = turtle.Turtle()
        novo_segmento.speed(0)
        novo_segmento.shape("circle")
        novo_segmento.color("green")
        novo_segmento.penup()
        segmentos.append(novo_segmento)

        pontos += 1
        if pontos > recorde:
            # atualizar recorde só quando terminar ou se desejar persistir imediatamente
            recorde = pontos
            salvar_recorde()

        atualizar_placar()

        if not comida_bonus_ativa and random.random() < 0.1:
            spawnar_comida_bonus()

    if comida_bonus_ativa and cabeca.distance(comida_bonus) < 20:
        tocar_som("comer")
        tocar_som("comer")
        pontos += 5
        if pontos > recorde:
            recorde = pontos
            salvar_recorde()
        atualizar_placar()
        esconder_comida_bonus()
        for _ in range(3):
            cabeca.color("gold")
            tela.update()
            time.sleep(0.05)
            cabeca.color("lime")
            tela.update()
            time.sleep(0.05)

    if comida_bonus_ativa and time.time() - comida_bonus_tempo > 5:
        esconder_comida_bonus()

    # mover corpo: atualizar segmentos do fim para o inicio
    for index in range(len(segmentos)-1, 0, -1):
        x = segmentos[index-1].xcor()
        y = segmentos[index-1].ycor()
        segmentos[index].goto(x, y)

    # mover o primeiro segmento para a posição da cabeça (fora do loop)
    if len(segmentos) > 0:
        x = cabeca.xcor()
        y = cabeca.ycor()
        segmentos[0].goto(x, y)

    mover()

    for segmento in segmentos:
        if segmento.distance(cabeca) < 20:
            resetar_apos_colisão()
            break

    time.sleep(velocidade_jogo)

tela.mainloop()
