#Desafio 1:dividir um determinado número e descobrir se é um número primo

count = 0
divide = []
num = int(input('Digite um número: '))

for i in range(1, num + 1):
    if num % i == 0:
        print('\033[32m', end='')
        count += 1
        divide.append(i)

    else:
        print('\033[33m', end='')
    print(f'{i}', end= '  ')

print(f'\n\033[m0 número {num} foi divisivel {count} vezes.')

print(f'Divisores de {num}: {divide}')

print(f' {num} é primo.' if len(divide) == 2 else f'{num} não é primo.' )
