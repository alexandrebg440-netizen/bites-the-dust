#função para mostar game over
def mostrar_game_over():
    global jogo_ativo
    jogo_ativo = False

    tela_mensagem.clear()

    # Efeito visual de game over
    tela.bgcolor("dark red")
    tela.update()
    time.sleep(0.1)
    tela.bgcolor("dark red")
    tela.update()
    time.sleep(0.1)
    tela.bgcolor("black")

    tela_mensagem.goto(0, 100)
    tela_mensagem.color("red")
    tela_mensagem.write(" GAME OVER", align="center", font=("Courier", 32, "bold"))
    
    tela_mensagem.goto(0, 40)
    tela_mensagem.color("white")
    tela_mensagem.write("Pontuação Final", align="center", font=("Courier", 20, "bold"))

    tela_mensagem.goto(0, 0)
    tela_mensagem.color("yellow")
    tela_mensagem.write("Pontuação", align="center", font=("Courier", 18, "bold"))

    if pontos >= recorde and pontos > 0:
        
        tela_mensagem.goto(0, -40)
        tela_mensagem.color("gold")
        tela_mensagem.write("Novo recorde!", align="center", font=("Courier", 20, "bold"))

    tela_mensagem.goto(0, -100)
    tela_mensagem.color("cyan")
    tela_mensagem.write("Pressione ESPAÇO para jogar novamente", align="center", font=("Courier", 14, "bold"))

    tela_mensagem.goto(0, -130)
    tela_mensagem.color("white")
    tela_mensagem.write("Pressione M para o Menu Principal", align="center", font=("Courier", 14, "bold"))

    tela.update()

#Função para iniciar o jogo
def iniciar_jogo(dificuldade):
    global pontos, velocidade_jogo, jogo_ativo, jogo_pausado, dificuldade_atual
    global comida_bonus_ativa, comida_bonus_tempo

    dificuldade_atual = dificuldade
    velocidade_jogo = DIFICULDADES[dificuldade]["velocidade"]

    tocar_som("inicio")

    #Limpar tela de inicio
    tela_mensagem.clear()

    #Configurar cor de fundo
    tela.bgcolor(DIFICULDADES[dificuldade]["cor_fundo"])

    #Resetar variaveis
    ponto = 0 
    jogo_pausado = False
    jogo_ativo = True
    comida_bonus_ativa = False
    comida_bonus_tempo = 0

    # Resetar cobrinha
    cabeca.goto(0, 0)
    cabeca.direction = "stop"
    cabeca.showturtle()

    #Limpar segmentos
    for segmento in segmentos:
        segmento.hideturtle()
    segmentos.clear()

    #Resetar comida
    comida.goto(0, 100)
    comida.showturtle()

    #esconder comida especial
    comida_bonus.goto(1000, 1000)
    comida_bonus.hideturtle()

    
